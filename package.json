{
  "name": "@remote-kakao/monorepo",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "kakaotalk",
    "kakaotalk-bot",
    "remote-kakao"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "David Lee <me@tica.fun>",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "oxlint --config .config/.oxlintrc.json --no-error-on-unmatched-pattern",
    "fmt": "oxfmt --config .config/.oxfmtrc.json --no-error-on-unmatched-pattern",
    "build:core": "cd packages/core && tsc",
    "build:ios": "cd clients/ios-tweak && make package FINALPACKAGE=1",
    "sideload": "./scripts/sideload.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
