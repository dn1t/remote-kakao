{
  "name": "@remote-kakao/monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "LGPL-3.0-or-later",
  "author": "David Lee <me@tica.fun>",
  "scripts": {
    "prepare": "husky",
    "lint": "oxlint --config .config/.oxlintrc.json --no-error-on-unmatched-pattern",
    "fmt": "oxfmt --config .config/.oxfmtrc.json --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm run lint",
      "pnpm run fmt"
    ],
    "*.{json,css,yaml,md}": "pnpm run fmt"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
